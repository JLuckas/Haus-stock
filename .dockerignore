# Never ship secrets or local state in the image.
.env
.env.*
!.env.example
.neon
database/*.sqlite
database/*.sqlite-journal

# Rebuilt inside the image.
node_modules
vendor
public/build
public/hot
bootstrap/cache/*.php

# Runtime leftovers from local runs.
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/app/*

# Not needed in production.
.git
.github
.claude
.idea
.vscode
tests
phpunit.xml
*.log
